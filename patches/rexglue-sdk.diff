+void SDLAudioDriver::PlayOneVideoFrame() {
+  // Three driver frames of 256 samples per video frame (768 samples: audio runs
+  // 4% slow against 1/60 s frames), a whole number so audio positions do not
+  // depend on the frame the audio started at. Each frame played releases the
+  // game's audio callback once (it mixes the next frame, or nothing when its
+  // audio is idle); the swap waits until those callbacks have returned, so the
+  // game sees the same audio progress at every frame of every run. Nothing
+  // queued means idle audio: nothing to play, nothing owed. A callback that
+  // does not return within 50 ms is left running, so a stall cannot hang.
+  std::unique_lock<std::mutex> guard(frames_mutex_);
+  if (++frame_clock_frames_ % 3600 == 0) {
+    REXAPU_INFO("audio_frame_clock: {} frames, {} waited for callbacks, {} gave up", frame_clock_frames_,
+                frame_clock_waits_, frame_clock_timeouts_);
+  }
+  const uint64_t returned_before = callbacks_returned_;
+  uint64_t released = 0;
+  for (int i = 0; i < 3 && !frames_queued_.empty(); ++i) {
+    frames_unused_.push(frames_queued_.front());
+    frames_queued_.pop();
+    semaphore_->Release(1, nullptr);
+    ++released;
+  }
+  auto done = [&] { return callbacks_returned_ >= returned_before + released; };
+  if (done()) return;
+  ++frame_clock_waits_;
+  if (!frames_submitted_.wait_for(guard, std::chrono::milliseconds(50), done) &&
+      ++frame_clock_timeouts_ <= 40) {
+    REXAPU_WARN("audio_frame_clock: frame {}: the audio callback did not return within 50 ms",
+                frame_clock_frames_);
+  }
+}
 
