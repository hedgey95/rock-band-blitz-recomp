+void CaptureSwapIfRequested(ui::Presenter* presenter, memory::Memory* memory) {
+  static uint32_t swaps = 0;
+  // Re-read when it changes: the game may set it during the run.
+  static std::string list;
+  static std::vector<uint32_t> frames;
+  if (std::string now = cvar::GetFlagByName("screenshot_frames"); now != list) {
+    list = std::move(now);
+    frames.clear();
+    for (size_t pos = 0; pos < list.size();) {
+      size_t end = std::min(list.find(',', pos), list.size());
+      frames.push_back(uint32_t(std::strtoul(list.substr(pos, end - pos).c_str(), nullptr, 10)));
+      pos = end + 1;
+    }
+  }
+  ++swaps;
+  if (!presenter || std::find(frames.begin(), frames.end(), swaps) == frames.end()) return;
+  // With the game's --dump_memory too, guest physical memory as of this swap on
+  // the GPU timeline (with --readback_resolve=full, it holds the frame's resolves).
+  if (const std::string dump = cvar::GetFlagByName("dump_memory"); !dump.empty() && memory) {
