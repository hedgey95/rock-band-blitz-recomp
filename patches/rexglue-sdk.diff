+// Key slots 0xE0-0xE7 are filled by the title itself (the XDK wrapper adds 0xE0
+// to an index < 8 and requires 16 bytes); Rock Band uses them to unwrap song keys.
+// The real hypervisor first deobscures the key with a console secret; that step is
+// not emulated, so titles must be handed already-deobscured keys.
+constexpr uint32_t kTitleKeyFirst = 0xE0, kTitleKeyCount = 8;
+static std::mutex title_keys_mutex;
+static std::array<std::array<uint8_t, 16>, kTitleKeyCount> title_keys;
+static std::array<bool, kTitleKeyCount> title_key_set;
+
+u32 XeKeysSetKey_entry(u32 key_num, mapped_void key_ptr, u32 key_size) {
+  uint32_t slot = key_num - kTitleKeyFirst;
+  if (slot >= kTitleKeyCount || !key_ptr || key_size != 16) {
+    REXKRNL_WARN("XeKeysSetKey({:X}, size {}) rejected", (uint32_t)key_num, (uint32_t)key_size);
+    return X_STATUS_INVALID_PARAMETER;
+  }
+  std::lock_guard lock(title_keys_mutex);
+  std::memcpy(title_keys[slot].data(), key_ptr.as<const uint8_t*>(), 16);
+  title_key_set[slot] = true;
+  return X_STATUS_SUCCESS;
+}
+
+u32 XeKeysAesCbc_entry(u32 key_num, mapped_void inp_ptr, u32 inp_size, mapped_void out_ptr,
+                       mapped_void feed_ptr, u32 encrypt) {
+  uint32_t slot = key_num - kTitleKeyFirst;
+  std::array<uint8_t, 16> key;
+  {
+    std::lock_guard lock(title_keys_mutex);
+    if (slot >= kTitleKeyCount || !title_key_set[slot]) {
+      // Console keys (fuses, keyvault) do not exist here.
+      REXKRNL_WARN("XeKeysAesCbc: key {:X} not available", (uint32_t)key_num);
+      return X_STATUS_UNSUCCESSFUL;
+    }
+    key = title_keys[slot];
+  }
+  if (!inp_ptr || !out_ptr || inp_size % 16) {
+    return X_STATUS_INVALID_PARAMETER;
+  }
+  XECRYPT_AES_STATE aes;
+  XeCryptAesKey_entry(ppc_ptr_t<XECRYPT_AES_STATE>::from_host(&aes),
+                      mapped_void::from_host(key.data()));
+  // A null feed means a zero IV that the caller does not get back.
+  uint8_t zero_feed[16] = {};
+  XeCryptAesCbc_entry(ppc_ptr_t<XECRYPT_AES_STATE>::from_host(&aes), inp_ptr, inp_size, out_ptr,
+                      feed_ptr ? feed_ptr : mapped_void::from_host(zero_feed), encrypt);
+  return X_STATUS_SUCCESS;
+}
