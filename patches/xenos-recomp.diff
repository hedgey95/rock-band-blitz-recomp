+// D3D device as a whole (docs/d3d-device-map.md), so names do not matter.
+static const ConstantTableContainer* synthesizeConstantTable(const uint8_t* shaderData, bool isPixelShader, std::vector<uint8_t>& buffer)
+{
+    const auto shaderContainer = reinterpret_cast<const ShaderContainer*>(shaderData);
+    bool literal[256] = {};
+    if (shaderContainer->definitionTableOffset != NULL)
+    {
+        auto definitions = reinterpret_cast<const DefinitionTable*>(shaderData + shaderContainer->definitionTableOffset)->definitions;
+        for (; *definitions != 0; definitions += 2)
+        {
+            auto definition = reinterpret_cast<const Float4Definition*>(definitions);
+            for (uint32_t i = 0; i < (definition->count + 3u) / 4; i++)
+            {
+                uint32_t reg = definition->registerIndex + i - (isPixelShader ? 256 : 0);
+                if (reg < 256)
+                    literal[reg] = true;
+            }
+        }
+    }
