+    const size_t infoOffset = tableSize;
+    size_t namesOffset = infoOffset + entries.size() * sizeof(ConstantInfo);
+    buffer.assign(sizeof(uint32_t) + namesOffset, 0);
+    put(4 + 3 * 4, uint32_t(entries.size()), 4); // constants
+    put(4 + 4 * 4, uint32_t(infoOffset), 4);     // constantInfo
+    for (size_t i = 0; i < entries.size(); i++)
+    {
+        size_t at = 4 + infoOffset + i * sizeof(ConstantInfo);
+        put(at, uint32_t(buffer.size() - 4), 4);   // name
+        put(at + 4, uint32_t(entries[i].set), 2);
+        put(at + 6, entries[i].index, 2);
+        put(at + 8, entries[i].count, 2);
+        buffer.insert(buffer.end(), entries[i].name.begin(), entries[i].name.end());
+        buffer.push_back(0);
+    }
+    return reinterpret_cast<const ConstantTableContainer*>(buffer.data());
